{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "wheat-temperature-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-23",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"workers_dev": true,
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	"vars": {
		"ENVIRONMENT": "development",
		"ALLOWED_ORIGIN": "https://charliecooke221.github.io,http://localhost:5173",
		"DASHBOARD_URL": "https://charliecooke221.github.io/wheat-temperature-frontend/",
		"ALERT_SENDER_NAME": "Wheat Temperature",
		"LOGIN_FAILURE_DELAY_MS": "750"
	},
	// Retries a failed alert email and clears old login-limit rows.
	"triggers": {
		"crons": ["*/15 * * * *"]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "wheat-temperature",
			"database_id": "36a7b613-6f28-467c-a237-dc4d57ed8a68",
			"migrations_dir": "migrations"
		}
	]
}